#!/bin/sh
# Contract review check: reviews any frontend type file staged in this
# commit against its backend counterpart via the tapit-ai CLI. Warns on
# drift but does not block the commit.
#
# One-time setup after cloning: git config core.hooksPath scripts/hooks

CHANGED=$(git diff --cached --name-only --diff-filter=ACM -- 'src/types/*.ts')

STEMS=""
for f in $CHANGED; do
  name=$(basename "$f" .ts)
  case " $STEMS " in
    *" $name "*) ;;
    *) STEMS="$STEMS $name" ;;
  esac
done

if [ -z "$STEMS" ]; then
  exit 0
fi

AI_TOOLS_DIR="../tap-it-ai-tools"
if [ ! -d "$AI_TOOLS_DIR" ]; then
  echo "ERROR: pre-commit contract review requires the sibling tap-it-ai-tools repo at $AI_TOOLS_DIR, but it was not found." >&2
  echo "Commit blocked. To bypass in an emergency: git commit --no-verify" >&2
  exit 1
fi

if ! command -v tapit-ai >/dev/null 2>&1; then
  echo "ERROR: 'tapit-ai' command not found on PATH. Contract review cannot run." >&2
  echo "Commit blocked. To bypass in an emergency: git commit --no-verify" >&2
  exit 1
fi

FAILED=0
for stem in $STEMS; do
  # src/types/admin.ts is explicitly paired with app/schemas/admin/admin_dashboard.py
  # (stems don't match by naming convention) - see tapit_ai/utils/discovery.py
  case "$stem" in
    admin) backend_rel="app/schemas/admin/admin_dashboard.py" ;;
    *) backend_rel="app/schemas/$stem.py" ;;
  esac

  if [ ! -f "../tap-it-server/$backend_rel" ]; then
    echo "No backend counterpart for '$stem' ($backend_rel not found) - skipping contract review for this file."
    continue
  fi

  echo "Reviewing contract: $stem"
  ( cd "$AI_TOOLS_DIR" && tapit-ai review contracts --file "$stem" --report )
  if [ $? -ne 0 ]; then
    FAILED=1
  fi
done

if [ "$FAILED" -ne 0 ]; then
  echo "" >&2
  echo "WARNING: contract review found issues for one or more changed type files. Commit is NOT blocked -- review the output above before pushing." >&2
fi

exit 0
